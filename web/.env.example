# Dịch vụ MediTrace chạy tại chỗ (python -m src.dich_vu --cong 8765)
MEDITRACE_API="http://127.0.0.1:8765"
# Khoá nội bộ BẮT BUỘC, đặt cùng giá trị cho dịch vụ Python; gửi qua header X-MediTrace-Internal-Token
MEDITRACE_INTERNAL_TOKEN=""

# Cổng của giao diện
PORT="3000"
# Địa chỉ lắng nghe. Chế độ phát triển mặc định 127.0.0.1; chỉ đặt 0.0.0.0 khi thật sự cần mở ra mạng LAN
HOST=""
# Tên miền được phép gọi vào Vite khi phát triển (vd tên miền đường hầm), cách nhau bởi dấu phẩy
MEDITRACE_ALLOWED_HOSTS=""

# Khoá HMAC của sổ ký duyệt WORM (chuỗi ngẫu nhiên >= 32 ký tự). Bỏ trống thì máy chủ tự sinh vào
# ~/.meditrace/worm.key (đổi chỗ bằng MEDITRACE_WORM_KEY_FILE). Mất khoá = không xác minh được chuỗi: SAO LƯU.
MEDITRACE_WORM_KEY=""
# Chỉ đặt =1 một lần khi người vận hành đã kiểm tra và muốn neo lại sổ WORM sau khi mất tệp .anchor.json
# MEDITRACE_WORM_NEO_LAI="1"

# Giới hạn gọi mô hình ngoài theo từng người dùng
MEDITRACE_NGOAI_TOI_DA_PHUT="10"
MEDITRACE_NGOAI_TOI_DA_NGAY="200"

# KHÔNG cần khoá API của dịch vụ ngoài. Bản này không gọi mô hình thương mại:
# hội thoại khám bệnh không được gửi ra máy chủ ngoài.
